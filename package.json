{
	"name": "playims",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"scripts": {
		"dev": "vite dev --open",
		"dev:portless": "portless playims vite dev",
		"catch-up": "node scripts/catch-up.mjs",
		"updates": "ncu --interactive --format group",
		"db:migrate:local": "wrangler d1 migrations apply playims-central-db-dev --local",
		"db:studio:local": "node scripts/kill-listener-port.mjs 4983 && drizzle-kit studio --config=drizzle.local.config.ts",
		"dev:pages": "pnpm build && pnpm exec wrangler pages dev .svelte-kit/cloudflare --port 8788",
		"db:migrate:remote": "wrangler d1 migrations apply playims-central-db-dev --remote",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"pwa-assets": "pwa-assets-generator",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm lint && pnpm test && pnpm check",
		"test:auth": "vitest run tests/auth",
		"test:members": "vitest run tests/members"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261001.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.4",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.8",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"baseline-browser-mapping": "^2.11.26",
		"drizzle-kit": "^0.31.11",
		"esbuild": "0.28.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "4.1.11",
		"workbox-build": "7.4.1",
		"workbox-window": "7.4.1",
		"wrangler": "^4.145.0"
	},
	"dependencies": {
		"@dnd-kit-svelte/svelte": "0.1.6",
		"@tabler/icons-svelte": "^3.48.0",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-color": "^3.31.4",
		"@tiptap/extension-highlight": "^3.31.4",
		"@tiptap/extension-image": "3.31.4",
		"@tiptap/extension-link": "^3.31.4",
		"@tiptap/extension-list": "3.31.4",
		"@tiptap/extension-table": "3.31.4",
		"@tiptap/extension-text-style": "^3.31.4",
		"@tiptap/extension-underline": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.3",
		"flag-icons": "^7.5.0",
		"sanitize-html": "^2.18.0",
		"zod": "^4.6.5"
	},
	"pnpm": {
		"overrides": {
			"devalue": "^5.6.4"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
