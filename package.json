{
	"name": "playims",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev --open",
		"dev:portless": "portless playims vite dev",
		"catch-up": "node scripts/catch-up.mjs",
		"updates": "ncu --interactive --format group",
		"db:migrate:local": "wrangler d1 migrations apply playims-central-db-dev --local",
		"db:studio:local": "node scripts/kill-listener-port.mjs 4983 && drizzle-kit studio --config=drizzle.local.config.ts",
		"dev:pages": "pnpm build && pnpm exec wrangler pages dev .svelte-kit/cloudflare --port 8788",
		"db:migrate:remote": "wrangler d1 migrations apply playims-central-db-dev --remote",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"pwa-assets": "pwa-assets-generator",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm lint && pnpm test && pnpm check",
		"test:auth": "vitest run tests/auth",
		"test:members": "vitest run tests/members"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260329.1",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"baseline-browser-mapping": "^2.10.12",
		"drizzle-kit": "^0.31.10",
		"esbuild": "0.27.4",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.5",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.57.2",
		"vite": "^8.0.3",
		"vitest": "4.1.2",
		"workbox-build": "7.4.0",
		"workbox-window": "7.4.0",
		"wrangler": "^4.78.0"
	},
	"dependencies": {
		"@dnd-kit-svelte/svelte": "0.1.6",
		"@tabler/icons-svelte": "^3.41.1",
		"@tiptap/core": "^3.22.0",
		"@tiptap/extension-color": "^3.22.0",
		"@tiptap/extension-highlight": "^3.22.0",
		"@tiptap/extension-link": "^3.22.0",
		"@tiptap/extension-text-style": "^3.22.0",
		"@tiptap/extension-underline": "^3.22.0",
		"@tiptap/pm": "^3.22.0",
		"@tiptap/starter-kit": "^3.22.0",
		"date-fns": "^4.1.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.2",
		"flag-icons": "^7.5.0",
		"sanitize-html": "^2.17.2",
		"zod": "^4.3.6"
	},
	"pnpm": {
		"overrides": {
			"devalue": "^5.6.4"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
